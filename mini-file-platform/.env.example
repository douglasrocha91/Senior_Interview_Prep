# Example environment variables
# Copy this to .env and fill in the values

# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# S3 Bucket Names
INPUT_BUCKET=
PROCESSED_BUCKET=
OUTPUT_BUCKET=

# Database Configuration (if any)
DATABASE_URL=

# Service-specific variables
SUBMITTER_API_URL=
INGEST_LAMBDA_FUNCTION_NAME=
PROCESSOR_WORKER_QUEUE_URL=
STATUS_API_ENDPOINT=

# Logging
LOG_LEVEL=INFO