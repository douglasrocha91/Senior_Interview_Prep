# Copy this file to .env and fill in the values before running any service.
# Never commit .env to version control.

# ─── AWS ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─── S3 ─────────────────────────────────────────────────────────────────────
# Bucket names must be globally unique. Add a personal suffix if needed.
S3_INBOUND_BUCKET=mini-file-platform-inbound
S3_RESULTS_BUCKET=mini-file-platform-results

# ─── SQS ────────────────────────────────────────────────────────────────────
# Populated automatically after running `make infra-aws`
SQS_FILE_JOBS_URL=
SQS_FILE_JOBS_DLQ_URL=
SQS_MAX_RECEIVE_COUNT=3
SQS_VISIBILITY_TIMEOUT=30

# ─── Lambda ─────────────────────────────────────────────────────────────────
LAMBDA_INGEST_FUNCTION_NAME=mini-file-platform-ingest

# ─── DynamoDB Local ──────────────────────────────────────────────────────────
DYNAMODB_ENDPOINT_URL=http://localhost:8000
DYNAMODB_TABLE_TRANSACTIONS=transactions

# ─── GPG ─────────────────────────────────────────────────────────────────────
# Email matching the GPG key used to encrypt inbound files
GPG_RECIPIENT_EMAIL=
# Optional: override GPG home directory
GPG_HOME=

# ─── Status API ──────────────────────────────────────────────────────────────
STATUS_API_HOST=0.0.0.0
STATUS_API_PORT=8080

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
